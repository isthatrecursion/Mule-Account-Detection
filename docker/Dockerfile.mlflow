FROM ghcr.io/mlflow/mlflow:v3.17.2@sha256:2cc40b3208991940d824d04f339833a0b69507569012aa5ec545690608602fc0
RUN pip install --no-cache-dir 'mlflow[auth]==3.17.2' 'psycopg[binary]==3.3.6'
COPY docker/mlflow_entrypoint.py /opt/mule/mlflow_entrypoint.py
ENTRYPOINT ["python", "/opt/mule/mlflow_entrypoint.py"]
