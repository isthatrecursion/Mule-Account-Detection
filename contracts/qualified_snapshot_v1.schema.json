  "required": [
    "contract_version",
    "snapshot_id",
    "record_key",
    "account_id",
    "source_id",
    "source_contract_version",
    "identity_approval_reference",
    "snapshot_at",
    "observation_start",
    "observation_cutoff",
    "available_at",
    "features",
