# Copy to .env locally and explicitly select it with --dotenv .env.
# These uncredentialed local examples do not create a database/tracking service.
MULE_ENVIRONMENT=local
MULE_DATABASE_URL=postgresql+psycopg://mule_runtime@127.0.0.1:55432/mule_operational
MULE_MLFLOW_URI=http://127.0.0.1:5000
# MULE_ARTIFACT_ROOT=var/artifacts
# MULE_MAX_UPLOAD_BYTES=134217728
# MULE_MAX_BATCH_ROWS=100000
# MULE_MODEL_TIER=research_demo
# Inject real passwords from ignored secret files; never commit credentialed URLs.
# MULE_MIGRATION_DATABASE_URL_FILE=secrets/migration_database_url
# Dedicated PostgreSQL tests require MULE_TEST_ENVIRONMENT=test and mule_test_* URLs.
# See docs/persistence.md and scripts/configure_local_database.py.

# Frontend trust/settings are loaded from ignored secrets/ui.json, not .env.
# Start with config/ui.example.json and supply organization identity settings.
# display_timezone=UTC, verify_tls=true, connect_timeout=3, read_timeout=20,
# write_timeout=60, poll_seconds=5, max_poll_seconds=300, page_size=25.
# Explicit synthetic component preview: .venv/Scripts/python.exe -m ui.dev
